@page
@using TraceLinq.Data.Models
@model TraceLinq.Pages.Inspector.IndexModel
@{
    ViewData["Title"] = "Inspector Dashboard";
}

<h1 class="h3 mb-3">Inspector Dashboard</h1>

<a asp-page="History" class="btn btn-outline-secondary mb-3">View inspection history</a>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-bg-warning">
            <div class="card-body">
                <h5 class="card-title">Pending</h5>
                <p class="display-6 mb-0">@Model.PendingCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-success">
            <div class="card-body">
                <h5 class="card-title">Passed</h5>
                <p class="display-6 mb-0">@Model.PassedCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-danger">
            <div class="card-body">
                <h5 class="card-title">Failed</h5>
                <p class="display-6 mb-0">@Model.FailedCount</p>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.Filter == "Pending" ? "active" : "")" asp-page="Index" asp-route-filter="Pending">Pending</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Filter == "Passed" ? "active" : "")" asp-page="Index" asp-route-filter="Passed">Passed</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Filter == "Failed" ? "active" : "")" asp-page="Index" asp-route-filter="Failed">Failed</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Filter == "All" ? "active" : "")" asp-page="Index" asp-route-filter="All">All</a>
    </li>
</ul>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Batch ID</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Producer</th>
            <th>Production Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model.Batches)
        {
            <tr>
                <td>@b.BatchId</td>
                <td>@b.ProductType</td>
                <td>@b.Quantity @b.Unit</td>
                <td>@b.Producer.FullName</td>
                <td>@b.ProductionDate</td>
                <td>@b.Status</td>
                <td>
                    @if (b.Status == BatchStatus.Registered)
                    {
                        <a asp-page="Check" asp-route-id="@b.BatchId" class="btn btn-sm btn-primary">Inspect</a>
                    }
                    else if (b.QualityCheck != null && !string.IsNullOrEmpty(b.QualityCheck.Remarks))
                    {
                        <span class="text-muted small">@b.QualityCheck.Remarks</span>
                    }
                </td>
            </tr>
        }
        @if (!Model.Batches.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No batches found.</td>
            </tr>
        }
    </tbody>
</table>
