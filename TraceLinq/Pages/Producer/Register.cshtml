@page
@using TraceLinq.Data
@model TraceLinq.Pages.Producer.RegisterModel
@{
    ViewData["Title"] = "Register batch";
}

<div class="tl-page-head">
    <div>
        <p class="tl-eyebrow">Producer &middot; New batch</p>
        <h1>Register a batch</h1>
        <p class="tl-sub">A unique batch ID and QR code are created when you save.</p>
    </div>
    <a asp-page="Dashboard" class="btn btn-light-outline">Back to my batches</a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="tl-card tl-card-pad">
            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Input.ProductType" class="form-label"></label>
                    <input asp-for="Input.ProductType" class="form-control" maxlength="100" placeholder="e.g. Coffee Beans" autofocus />
                    <span asp-validation-for="Input.ProductType" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-8">
                        <label asp-for="Input.Quantity" class="form-label"></label>
                        <input asp-for="Input.Quantity" type="number" step="0.01" min="0.01" class="form-control" placeholder="e.g. 100" />
                        <span asp-validation-for="Input.Quantity" class="text-danger"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="Input.Unit" class="form-label"></label>
                        <select asp-for="Input.Unit" class="form-select" asp-items="@(new SelectList(BatchRules.Units))"></select>
                        <span asp-validation-for="Input.Unit" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.OriginLocation" class="form-label"></label>
                    <input asp-for="Input.OriginLocation" class="form-control" maxlength="150" placeholder="Farm or factory, e.g. Nyamagabe, Rwanda" />
                    <span asp-validation-for="Input.OriginLocation" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ProductionDate" class="form-label">Harvest / production date</label>
                    <input asp-for="Input.ProductionDate" type="date" class="form-control" style="max-width: 14rem"
                           max="@Model.Today.ToString("yyyy-MM-dd")"
                           value="@Model.Input.ProductionDate?.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="Input.ProductionDate" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Register batch</button>
                    <a asp-page="Dashboard" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
