<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - TraceLinq</title>
    <script>
        // Apply the saved (or system) theme before first paint to avoid a flash.
        (function () {
            try {
                var t = localStorage.getItem('tl-theme');
                if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.setAttribute('data-bs-theme', t);
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TraceLinq.styles.css" asp-append-version="true" />
</head>
<body>
@{
    var page = (ViewContext.RouteData.Values["page"] as string) ?? "";
    bool signedIn = User.Identity?.IsAuthenticated == true;
    var role = User.RoleName();
    bool Is(params string[] prefixes) => prefixes.Any(p => page.StartsWith(p, StringComparison.OrdinalIgnoreCase));
}
    <header class="tl-nav">
        <nav class="container d-flex flex-wrap align-items-center">
            <a class="tl-brand me-md-4" asp-page="/Index">
                <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="currentColor" /><path d="M9 21l5-8 4 6 5-10" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /><circle cx="9" cy="21" r="2.1" fill="#fff" /><circle cx="23" cy="9" r="2.1" fill="#fff" /></svg>
                TraceLinq
            </a>

            <button class="navbar-toggler ms-auto d-md-none border-0 shadow-none p-1" type="button" data-bs-toggle="collapse" data-bs-target="#tlNav" aria-controls="tlNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse d-md-flex flex-grow-1 align-items-center" id="tlNav">
                <ul class="navbar-nav flex-row flex-wrap mt-3 mt-md-0">
                @if (!signedIn)
                {
                    <li><a class="tl-nav-link @(Is("/Index") ? "active" : "")" asp-page="/Index">Home</a></li>
                }
                else if (role == "Admin")
                {
                    <li><a class="tl-nav-link @(Is("/Admin/Dashboard") ? "active" : "")" asp-page="/Admin/Dashboard">Overview</a></li>
                    <li><a class="tl-nav-link @(Is("/Admin/Users") ? "active" : "")" asp-page="/Admin/Users">Users</a></li>
                }
                else if (role == "Producer")
                {
                    <li><a class="tl-nav-link @(Is("/Producer/Dashboard", "/Producer/Details") ? "active" : "")" asp-page="/Producer/Dashboard">Dashboard</a></li>
                    <li><a class="tl-nav-link @(Is("/Producer/Register") ? "active" : "")" asp-page="/Producer/Register">Register batch</a></li>
                }
                else if (role == "Inspector")
                {
                    <li><a class="tl-nav-link @(Is("/Inspector/Index", "/Inspector/Check", "/Inspector/Dashboard") ? "active" : "")" asp-page="/Inspector/Index">Queue</a></li>
                    <li><a class="tl-nav-link @(Is("/Inspector/History") ? "active" : "")" asp-page="/Inspector/History">History</a></li>
                }
                else if (role == "Warehouse")
                {
                    <li><a class="tl-nav-link @(Is("/Warehouse") ? "active" : "")" asp-page="/Warehouse/Dashboard">Dashboard</a></li>
                }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <main role="main" class="tl-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="tl-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 TraceLinq</span>
            <span>Supply chain traceability, from producer to shelf.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
