@page
@using TraceLinq.Data.Models
@model TraceLinq.Pages.Trace.IndexModel
@{
    ViewData["Title"] = "Track a batch";
}

<div class="tl-page-head">
    <div>
        <p class="tl-eyebrow">Public tracing</p>
        <h1>Track a batch</h1>
        <p class="tl-sub">Enter a batch ID to see its journey from production to delivery.</p>
    </div>
</div>

<div class="tl-card tl-card-pad mb-4">
    <form method="get" class="d-flex flex-wrap gap-2">
        <input type="text" name="batchId" class="form-control" style="max-width: 22rem" placeholder="e.g. BT-20261105-001"
               aria-label="Batch ID" value="@Model.BatchId" />
        <button type="submit" class="btn btn-primary">Track</button>
    </form>
    <p class="tl-sub small mt-3 mb-0">
        <span class="tl-status tl-status-neutral">Coming soon</span> Scan a batch QR code to track it instantly.
    </p>
</div>

@if (Model.Searched)
{
    if (Model.Batch is null)
    {
        <div class="tl-card">
            <div class="tl-empty">
                <partial name="_Icon" model='"search"' />
                <strong>Batch not found</strong>
                Check the ID and try again.
            </div>
        </div>
    }
    else
    {
        var b = Model.Batch;
        var q = b.QualityCheck;
        var w = b.WarehouseStorage;

        <div class="tl-card tl-trace-card">
            <div class="tl-trace-head">
                <div>
                    <div class="tl-trace-id">@b.BatchId</div>
                    <div class="tl-trace-sub">@b.ProductType &middot; @b.Quantity.ToString("0.##") @b.Unit &middot; from @b.OriginLocation</div>
                </div>
                <partial name="_StatusBadge" model="b.Status.ToString()" />
            </div>

            <ol class="tl-timeline">
                <li style="--s-bg: var(--st-registered-bg); --s-fg: var(--st-registered);">
                    <span class="dot"><partial name="_Icon" model='"box"' /></span>
                    <strong>Produced and registered</strong>
                    <span>Produced @b.ProductionDate.ToString("d MMM yyyy") &middot; registered @b.CreatedAt.ToString("d MMM yyyy, HH:mm")</span>
                </li>

                @if (q is not null)
                {
                    var passed = q.Result == QualityResult.Passed;
                    <li style="--s-bg: var(--st-@(passed ? "passed" : "failed")-bg); --s-fg: var(--st-@(passed ? "passed" : "failed"));">
                        <span class="dot"><partial name="_Icon" model='"inspect"' /></span>
                        <strong>Quality check @(passed ? "passed" : "failed")</strong>
                        <span>
                            @q.CheckedAt.ToString("d MMM yyyy, HH:mm")
                            @if (!string.IsNullOrEmpty(q.Remarks))
                            {
                                <text>&middot; &ldquo;@q.Remarks&rdquo;</text>
                            }
                        </span>
                    </li>
                }
                else
                {
                    <li style="--s-bg: var(--tl-surface-2); --s-fg: var(--tl-muted);">
                        <span class="dot"><partial name="_Icon" model='"inspect"' /></span>
                        <strong>Awaiting quality check</strong>
                        <span>Next step in the journey</span>
                    </li>
                }

                @if (w is not null)
                {
                    <li style="--s-bg: var(--st-instorage-bg); --s-fg: var(--st-instorage);">
                        <span class="dot"><partial name="_Icon" model='"warehouse"' /></span>
                        <strong>Stored in @w.StorageLocation</strong>
                        <span>Received @w.ArrivalTime.ToString("d MMM yyyy, HH:mm")</span>
                    </li>

                    if (w.DispatchedAt is not null)
                    {
                        <li style="--s-bg: var(--st-dispatched-bg); --s-fg: var(--st-dispatched);">
                            <span class="dot"><partial name="_Icon" model='"truck"' /></span>
                            <strong>Dispatched</strong>
                            <span>@w.DispatchedAt.Value.ToString("d MMM yyyy, HH:mm")</span>
                        </li>
                    }
                    else
                    {
                        <li style="--s-bg: var(--tl-surface-2); --s-fg: var(--tl-muted);">
                            <span class="dot"><partial name="_Icon" model='"truck"' /></span>
                            <strong>Awaiting dispatch</strong>
                            <span>Still in storage</span>
                        </li>
                    }
                }
            </ol>
        </div>
    }
}
